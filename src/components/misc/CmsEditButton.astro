---
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

// 前端快捷写文章按钮：跳转到 /write/ 在线 Markdown 编辑器
// mode: "new" 打开空白编辑器（写新文章）
// mode: "edit" 打开编辑器加载指定文件
//   collection: "posts" | "pages" | "dynamic"
//   entry: 文件名（posts 用 .md 文件名去扩展名，pages 用 spec 名）
interface Props {
	mode?: "new" | "edit";
	collection?: "posts" | "pages" | "dynamic";
	entry?: string;
}

const { mode = "new", collection, entry } = Astro.props;
const params = new URLSearchParams();
params.set("mode", mode);
if (collection) params.set("collection", collection);
if (entry) params.set("entry", entry);
const href = `${url("/write/")}?${params.toString()}`;
---

<a
	href={href}
	target="_blank"
	rel="noopener"
	class="cms-edit-btn"
	title="在 /write/ 编辑器中打开"
	aria-label="在 /write/ 编辑器中打开"
>
	<Icon name="material-symbols:edit-rounded" class="text-[1.35rem]" />
</a>

<style>
	.cms-edit-btn {
		position: fixed;
		right: 1rem;
		bottom: 6rem;
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 999px;
		background: var(--primary, #10b981);
		color: #fff;
		box-shadow:
			0 4px 14px color-mix(in srgb, var(--primary, #10b981) 40%, transparent);
		transition:
			transform 0.15s ease,
			opacity 0.15s ease;
		opacity: 0.85;
	}
	.cms-edit-btn:hover {
		transform: scale(1.08);
		opacity: 1;
	}
	@media print {
		.cms-edit-btn {
			display: none;
		}
	}
</style>
