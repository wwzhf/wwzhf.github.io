---
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

// 侧边栏「写文章」卡（复刻 fqzlr 左侧编辑卡）
// 规则（2026-08-31 用户确认）：只显示在 /posts/、/archive/、/categories/ 三个页面，
// 其他页面（含文章详情页/主页/关于页等）一律不渲染。
// 三个页面内仅显示「写新文章」（入口固定指向 /write/）
const WRITE_CARD_PATHS = ["/posts/", "/archive/", "/categories/"];
const path = Astro.url.pathname;

// 不在白名单页面时直接不渲染
if (!WRITE_CARD_PATHS.includes(path)) {
	return null;
}

const href = `${url("/write/")}?mode=new`;
---

<div class:list={["card-base", "p-4", Astro.props.class]} style={Astro.props.style}>
	<div
		class="flex items-center gap-2 text-base font-bold mb-3 dark:text-neutral-50 transition"
	>
		<Icon name="material-symbols:edit-rounded" class="text-[1.2rem] text-(--primary)" />
		<span>写文章</span>
	</div>
	<div class="flex flex-col gap-2">
		<a
			href={href}
			class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95 flex items-center"
		>
			<Icon name="material-symbols:note-add-rounded" class="text-[1.35rem]" />
			写新文章
		</a>
	</div>
</div>
