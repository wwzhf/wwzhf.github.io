---
import { Icon } from "astro-icon/components";

// 侧边栏「编辑页面导航」卡（仅 /projects/ 网站导航页显示）
// 用 <button> 而非 <a>：swup 只拦截 <a> 链接，button 点击不受 swup 干扰
// 点击派发 fqzlr:edit-nav 事件 → EditNavManager 进入内联编辑模式
if (Astro.url.pathname !== "/projects/") {
	return null;
}
---

<div class:list={["card-base", "p-4", Astro.props.class]} style={Astro.props.style}>
	<div
		class="flex items-center gap-2 text-base font-bold mb-3 dark:text-neutral-50 transition"
	>
		<Icon name="material-symbols:edit-note-rounded" class="text-[1.2rem] text-(--primary)" />
		<span>页面导航</span>
	</div>
	<div class="flex flex-col gap-2">
		<button
			type="button"
			id="edit-booknav-trigger"
			class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95 flex items-center cursor-pointer"
		>
			<Icon name="material-symbols:bookmarks-rounded" class="text-[1.35rem]" />
			编辑页面导航
		</button>
	</div>
</div>

<script>
	// 点击「编辑页面导航」：派发事件给 EditNavManager（capture 阶段 + stopPropagation，
	// 彻底避免被 swup 等其它处理器干扰）。防重：侧边栏 static 容器随 swup 切页重载。
	if (!window.__editBooknavListener) {
		window.__editBooknavListener = true;
		document.addEventListener(
			"click",
			(e) => {
				const btn = (e.target as Element | null)?.closest?.("#edit-booknav-trigger");
				if (!btn) return;
				e.preventDefault();
				e.stopPropagation();
				document.dispatchEvent(new CustomEvent("fqzlr:edit-nav", { bubbles: true }));
			},
			true,
		);
	}
</script>
