---
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

// fqzlr 风格动态页眉：面包屑 + MOMENTS 标签 + 标题 + 订阅 + Banner（头像/名字/签名/动态数）
interface Props {
	title: string;
	count: number;
}
const { title, count } = Astro.props;
---

<div class="card-base px-8 py-6 mb-4 overflow-hidden">
	<!-- 面包屑 -->
	<nav
		aria-label="Breadcrumb"
		class="flex items-center gap-1 text-sm text-(--content-meta) mb-1"
	>
		<a href={url("/")} class="hover:text-(--primary) transition-colors">
			首页
		</a>
		<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
		<span class="text-(--primary)">{title}</span>
	</nav>

	<!-- MOMENTS 标签 + 标题 + 订阅 -->
	<div class="flex items-center justify-between">
		<div>
			<div class="text-xs tracking-[0.2em] text-(--content-meta) mb-1">
				MOMENTS
			</div>
			<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
				{title}
			</h1>
		</div>
		<a
			href={url("/rss/")}
			class="btn-regular rounded-lg h-9 px-3 gap-1.5 text-sm font-bold flex items-center active:scale-95"
			title="订阅动态"
			aria-label="订阅动态"
		>
			<Icon name="material-symbols:rss-feed-rounded" class="text-[1.15rem]" />
			订阅
		</a>
	</div>

	<!-- Banner：头像 + 名字 + 签名 + 动态数 -->
	<div
		class="mt-5 flex items-center gap-4 rounded-xl px-5 py-4 bg-(--primary)/8"
	>
		<img
			src={url(profileConfig.avatar)}
			alt={profileConfig.name}
			class="w-12 h-12 rounded-full object-cover shrink-0"
		/>
		<div class="flex-1 min-w-0">
			<div class="font-bold text-neutral-900 dark:text-neutral-100">
				{profileConfig.name}
			</div>
			<div class="text-sm text-(--content-meta) truncate">
				{profileConfig.bio}
			</div>
		</div>
		<div class="flex items-center gap-1.5 text-sm shrink-0">
			<Icon
				name="material-symbols:dynamic-feed-rounded"
				class="text-(--primary)"
			/>
			<strong class="text-(--primary)">{count}</strong>
			<span class="text-(--content-meta)">条动态</span>
		</div>
	</div>
</div>
