---
import { Icon } from "astro-icon/components";
import { getEnabledFriends } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

// 朋友圈页（fqzlr 风格）：
//   面包屑 + CIRCLE 小标题 + "朋友圈"大标题 + 全部友链
//   + 好友 N · 动态 N + 最新发布按钮
//   + 动态卡网格：每条 = 文章标题 + 来源（友链名）+ 时间
// 数据源：完整版用 hexo-circle-of-friends 抓取 RSS data.json；
// 静态版用 friendsConfig 派生"动态"——每个友链生成 1-3 条模拟文章卡。

const friends = getEnabledFriends();
const friendCount = friends.length;

// 时间选项（倒序用）
const timeOptions = [
	"刚刚",
	"2 小时前",
	"昨天",
	"2 天前",
	"3 天前",
	"5 天前",
	"1 周前",
	"2 周前",
	"1 个月前",
];

// 派生"动态"列表——每个友链生成 1-2 条文章卡
type Moment = {
	id: string;
	title: string;
	author: string; // 来源友链名
	avatar: string;
	date: string;
	url: string;
};

const allMoments: Moment[] = [];
for (let i = 0; i < friends.length; i++) {
	const f = friends[i];
	const count = (i % 2) + 1; // 每个友链 1-2 条
	for (let j = 0; j < count; j++) {
		const idx = i * 2 + j;
		allMoments.push({
			id: `${f.title}-${j}`,
			title: j === 0 ? f.desc : `${f.desc}（续）`,
			author: f.title,
			avatar: f.imgurl,
			date: timeOptions[idx % timeOptions.length],
			url: f.siteurl,
		});
	}
}

const dynamicCount = allMoments.length;
---

<MainGridLayout title="朋友圈" description="好友们的最新动态">
	<circle-page>
		<!-- 页眉 -->
		<div class="card-base px-8 py-6 mb-4">
			<nav
				aria-label="Breadcrumb"
				class="flex items-center gap-1 text-sm text-(--content-meta) mb-1"
			>
				<a href={url("/")} class="hover:text-(--primary) transition-colors">首页</a>
				<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
				<span class="text-(--primary)">朋友圈</span>
			</nav>
			<div class="flex flex-wrap items-end justify-between gap-3">
				<div>
					<div class="text-xs tracking-[0.2em] text-(--primary) mb-1">CIRCLE</div>
					<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">朋友圈</h1>
				</div>
				<a
					href="/friends/"
					class="inline-flex items-center gap-1.5 text-sm font-medium text-(--primary) hover:underline"
				>
					全部友链
					<Icon name="material-symbols:chevron-right-rounded" class="text-base" />
				</a>
			</div>
		</div>

		<!-- 统计 + 排序 -->
		<div class="flex flex-wrap items-center justify-between gap-3 mb-4 px-1">
			<div class="text-sm text-(--content-meta)">
				好友 <strong class="text-(--primary)">{friendCount}</strong>
				<span class="mx-1">·</span>
				动态 <strong class="text-(--primary)">{dynamicCount}</strong>
			</div>
			<button
				class="btn-plain rounded-md h-8 px-3 gap-1.5 text-sm font-medium flex items-center bg-(--primary) text-white dark:text-black/70"
				aria-label="排序方式"
			>
				<Icon name="material-symbols:schedule-rounded" class="text-base" />
				最新发布
			</button>
		</div>

		<!-- 动态卡网格 -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
			{
				allMoments.length === 0 && (
					<div class="col-span-full card-base p-8 text-center text-(--content-meta)">
						<Icon
							name="material-symbols:group-off-outline"
							class="text-5xl mx-auto mb-3 opacity-50"
						/>
						<p>暂无友链动态</p>
						<p class="text-xs mt-2">前往 <a href="/friends/" class="text-(--primary) hover:underline">友链页</a> 添加好友</p>
					</div>
				)
			}
			{
				allMoments.map((m) => (
					<a
						href={m.url}
						target="_blank"
						rel="noopener noreferrer"
						class="moment-card card-base p-4 hover:border-(--primary) hover:shadow-md transition-all flex flex-col gap-3 group"
					>
						<h3 class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors line-clamp-2 grow">
							{m.title}
						</h3>
						<div class="flex items-center justify-between gap-2 text-xs">
							<div class="flex items-center gap-1.5 min-w-0">
								<img
									src={m.avatar}
									alt={m.author}
									class="h-4 w-4 rounded-sm object-cover shrink-0"
									loading="lazy"
								/>
								<span class="text-(--content-meta) truncate">{m.author}</span>
							</div>
							<span class="text-(--content-meta) shrink-0">{m.date}</span>
						</div>
					</a>
				))
			}
		</div>

		<!-- 数据源说明 -->
		<p class="text-xs text-(--content-meta) text-center mt-6 px-4">
			* 当前为静态朋友圈（基于友链配置派生占位内容）。如需实时抓取各站最新文章，
			请部署 <a
				href="https://github.com/Rock-Candy-Tea/hexo-circle-of-friends"
				target="_blank"
				rel="noopener noreferrer"
				class="text-(--primary) hover:underline"
			>hexo-circle-of-friends</a
			> 服务并对接 data.json 后即可显示真实动态。
		</p>
	</circle-page>
</MainGridLayout>
