---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import CmsEditButton from "@/components/misc/CmsEditButton.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 通用内容页模板：内容来自 src/content/spec/ 下同名 md 文件
const entry = await getEntry("spec", "changelog");

if (!entry) {
	throw new Error("Page content not found: spec/changelog");
}

const { Content } = await render(entry);
---

<MainGridLayout title="更新日志" description="更新日志">
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
    <CmsEditButton collection="pages" entry="changelog" />
</MainGridLayout>
