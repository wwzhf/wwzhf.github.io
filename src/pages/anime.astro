---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

// 动画页：内容已清空（保留页面框架与页眉，接入数据源时恢复）
const title = "动画";
const description = "追番记录";
---

<MainGridLayout title={title} description={description}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
      <!-- 面包屑 -->
      <nav
        aria-label="Breadcrumb"
        class="flex items-center gap-1 text-sm text-(--content-meta) mb-1"
      >
        <a href={url("/")} class="hover:text-(--primary) transition-colors">
          首页
        </a>
        <Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
        <span class="text-(--primary)">动画</span>
      </nav>

      <!-- 页面标题 -->
      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <div
              class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
            >
              <Icon name="fa7-brands:bilibili" class="text-[1.5rem]"></Icon>
            </div>
            <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              动画
            </div>
          </div>
        </div>

        <!-- 内容已清空占位 -->
        <div class="flex flex-col items-center justify-center py-20 text-neutral-400 dark:text-neutral-500">
          <Icon name="material-symbols:movie-filter-outline" class="text-5xl mb-4 opacity-50" />
          <p class="text-base">内容已清空</p>
        </div>
      </div>
    </div>
  </div>
</MainGridLayout>
