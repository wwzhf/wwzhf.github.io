---
import { getEntry, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 友链页（fqzlr 风格）：
//   面包屑 + FRIENDS 小标题 + "友链"大标题
//   + 操作按钮：如何申请友链 / 简洁视图 / 神奇按钮
//   + tab：全部 / Blog
//   + 横长友链卡片（封面 + 标题 + 描述）

if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

const friendsPost = await getEntry("spec", "friends");
if (!friendsPost) throw new Error("friends page content not found");
const { Content } = await render(friendsPost);

const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

const items = getEnabledFriends();
const allTags = [...new Set(items.flatMap((item) => item.tags || []))].sort();

const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<MainGridLayout title={title} description={description}>
	<friend-page data-simple="false">
		<!-- 页眉：面包屑 + FRIENDS + 大标题 -->
		<header class="card-base px-8 py-6 mb-4">
			<nav
				aria-label="Breadcrumb"
				class="flex items-center gap-1 text-sm text-(--content-meta) mb-1"
			>
				<a href="/" class="hover:text-(--primary) transition-colors">首页</a>
				<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
				<span class="text-(--primary)">友链</span>
			</nav>
			<div class="flex flex-wrap items-start justify-between gap-3">
				<div>
					<div class="text-xs tracking-[0.2em] text-(--primary) mb-1">FRIENDS</div>
					<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">友链</h1>
				</div>
				<div class="flex flex-wrap items-center gap-2">
					<button
						id="friend-howto-btn"
						type="button"
						class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-(--line-divider) text-sm font-medium hover:border-(--primary) hover:text-(--primary) transition-colors"
					>
						<Icon name="material-symbols:help-outline-rounded" class="text-base" />
						如何申请友链
					</button>
					<button
						id="friend-simple-btn"
						type="button"
						aria-pressed="false"
						class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-(--line-divider) text-sm font-medium hover:border-(--primary) hover:text-(--primary) transition-colors"
					>
						<Icon name="material-symbols:view-agenda-outline-rounded" class="text-base" />
						简洁视图
					</button>
					<a
						id="friend-magic-btn"
						href={`/friends/?random=${Date.now()}`}
						class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-(--line-divider) text-sm font-medium hover:border-(--primary) hover:text-(--primary) transition-colors"
					>
						<Icon name="material-symbols:auto-awesome-rounded" class="text-base" />
						神奇按钮
						<span class="text-[0.65rem] text-(--content-meta) ml-1">（我知道你不会点的）</span>
					</a>
				</div>
			</div>
		</header>

		<!-- tab：全部 / Blog -->
		<div class="flex items-center gap-2 mb-4 px-1">
			<button
				class="friend-tab px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
				data-tab="all"
				aria-selected="true"
			>全部</button>
			<button
				class="friend-tab px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
				data-tab="blog"
				aria-selected="false"
			>Blog</button>
		</div>

		<!-- 友链网格 -->
		<div class="friends-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
			{
				items.length === 0 && (
					<div class="col-span-full text-center py-16 text-(--content-meta)">
						<Icon
							name="material-symbols:group-off-outline"
							class="text-5xl mx-auto mb-3 opacity-50"
						/>
						<p>暂无友链</p>
					</div>
				)
			}
			{
				items.map((item) => (
					<a
						href={item.siteurl}
						target="_blank"
						rel="noopener noreferrer"
						data-tags={(item.tags || []).join(",")}
						class="friend-card group relative block rounded-xl border border-(--line-divider) hover:border-(--primary) overflow-hidden transition-all bg-(--card-bg) hover:shadow-lg"
					>
						{/* 封面背景（hover 显现） */}
						<div class="absolute inset-0 opacity-0 group-hover:opacity-10 transition-opacity pointer-events-none">
							<img
								src={item.imgurl}
								alt=""
								class="w-full h-full object-cover blur-md"
								loading="lazy"
							/>
						</div>
						<div class="relative flex items-center gap-3 p-4">
							<img
								src={item.imgurl}
								alt={item.title}
								class="h-12 w-12 rounded-lg object-cover shrink-0 border border-(--line-divider)"
								loading="lazy"
							/>
							<div class="grow min-w-0">
								<h3 class="font-bold text-base text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors truncate">
									{item.title}
								</h3>
								<p class="text-xs text-(--content-meta) line-clamp-1">
									{item.desc}
								</p>
							</div>
						</div>
					</a>
				))
			}
		</div>

		<!-- 自定义内容（来自 friends.mdx） -->
		{
			friendsPageConfig.showCustomContent !== false && (
				<div class="mt-6 card-base px-8 py-6">
					<Markdown>
						<Content />
					</Markdown>
				</div>
			)
		}

		<!-- 评论区 -->
		{
			isCommentEnabled && (
				<div class="mt-6">
					<Comment post={friendsPost} customPath="/friends/" />
				</div>
			)
		}
	</friend-page>
</MainGridLayout>

<!-- 申请友链说明 dialog -->
<dialog id="friend-howto-dialog" class="rounded-xl p-0 max-w-md w-[90vw] backdrop:bg-black/40">
	<div class="p-6">
		<div class="flex items-center justify-between mb-3">
			<h2 class="text-lg font-bold">如何申请友链</h2>
			<button
				id="friend-howto-close"
				type="button"
				class="text-(--content-meta) hover:text-(--primary)"
			>
				<Icon name="material-symbols:close-rounded" class="text-xl" />
			</button>
		</div>
		<ol class="list-decimal pl-5 space-y-2 text-sm text-neutral-700 dark:text-neutral-300">
			<li>确保你的站点能正常访问，且有持续的原创内容。</li>
			<li>先在本博客留言板留下你的站点信息（名称、链接、简介、头像）。</li>
			<li>站长看到后会主动添加，无需反复催促。</li>
			<li>禁止涉及违法违规内容，友链页对所有访客可见，请自重。</li>
		</ol>
		<div class="mt-4 text-right">
			<button
				id="friend-howto-ok"
				type="button"
				class="px-4 py-1.5 rounded-md bg-(--primary) text-white dark:text-black/70 text-sm font-medium"
			>我知道了</button>
		</div>
	</div>
</dialog>

<style>
	.friend-tab[aria-selected="true"] {
		background-color: var(--primary);
		color: white;
	}
	:global(.dark) .friend-tab[aria-selected="true"] {
		color: rgba(0, 0, 0, 0.7);
	}
	.friend-card[data-hidden="true"] {
		display: none;
	}
</style>

<script>
	class FriendPage extends HTMLElement {
		connectedCallback() {
			// tab 切换
			this.querySelectorAll<HTMLButtonElement>(".friend-tab").forEach((tab) => {
				tab.addEventListener("click", () => {
					const target = tab.dataset.tab;
					this.querySelectorAll<HTMLButtonElement>(".friend-tab").forEach((t) =>
						t.setAttribute(
							"aria-selected",
							t === tab ? "true" : "false",
						),
					);
					this.querySelectorAll<HTMLElement>(".friend-card").forEach((card) => {
						const tags = (card.dataset.tags || "").split(",");
						const visible = target === "all" || tags.includes("Blog");
						card.dataset.hidden = visible ? "false" : "true";
					});
				});
			});

			// 简洁视图切换
			const simpleBtn = this.querySelector<HTMLButtonElement>("#friend-simple-btn");
			simpleBtn?.addEventListener("click", () => {
				const simple = this.dataset.simple === "true";
				this.dataset.simple = simple ? "false" : "true";
				simpleBtn.setAttribute("aria-pressed", simple ? "false" : "true");
				if (simple) {
					simpleBtn.classList.remove("bg-(--primary)", "text-white");
				} else {
					simpleBtn.classList.add("bg-(--primary)", "text-white");
				}
			});

			// 神奇按钮：跳转到随机友链
			const magicBtn = this.querySelector<HTMLAnchorElement>("#friend-magic-btn");
			magicBtn?.addEventListener("click", (e) => {
				e.preventDefault();
				const cards = Array.from(
					this.querySelectorAll<HTMLAnchorElement>(".friend-card"),
				).filter((c) => c.dataset.hidden !== "true");
				if (cards.length === 0) return;
				const idx = Math.floor(Math.random() * cards.length);
				const url = cards[idx].href;
				window.open(url, "_blank", "noopener,noreferrer");
			});
		}
	}

	if (!customElements.get("friend-page")) {
		customElements.define("friend-page", FriendPage);
	}

	// dialog 逻辑（不依赖自定义元素，避免 SSR 不一致）
	const howtoBtn = document.getElementById("friend-howto-btn");
	const howtoDialog = document.getElementById("friend-howto-dialog") as HTMLDialogElement | null;
	const howtoClose = document.getElementById("friend-howto-close");
	const howtoOk = document.getElementById("friend-howto-ok");
	howtoBtn?.addEventListener("click", () => howtoDialog?.showModal());
	howtoClose?.addEventListener("click", () => howtoDialog?.close());
	howtoOk?.addEventListener("click", () => howtoDialog?.close());
</script>
