---
import PostPage from "@/components/layout/PostPage.astro";
import Pagination from "@/components/common/Pagination.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

// 文章列表页（fqzlr 风格）：面包屑页眉 + 文章卡片列表 + 分页
const allPosts = await getSortedPosts();
const perPage = siteConfig.pagination?.postsPerPage ?? 10;
const lastPage = Math.max(1, Math.ceil(allPosts.length / perPage));
const currentPage = Math.min(
	Math.max(1, Number(Astro.url.searchParams.get("page")) || 1),
	lastPage,
);
const start = (currentPage - 1) * perPage;
const end = Math.min(start + perPage, allPosts.length);

const page = {
	data: allPosts.slice(start, end),
	total: allPosts.length,
	size: end - start,
	currentPage,
	lastPage,
	start: start + 1,
	end,
	url: {
		current: Astro.url.pathname,
		first: "/posts/",
		last: `/posts/?page=${lastPage}`,
	},
};
---

<MainGridLayout title="文章列表" description="浏览全部文章">
	<!-- 面包屑页眉（fqzlr 风格） -->
	<div class="card-base px-8 py-6 mb-4">
		<nav
			aria-label="Breadcrumb"
			class="flex items-center gap-1 text-sm text-(--content-meta) mb-1"
		>
			<a href={url("/")} class="hover:text-(--primary) transition-colors">
				首页
			</a>
			<Icon name="material-symbols:chevron-right-rounded" class="text-[1rem]" />
			<span class="text-(--primary)">文章列表</span>
		</nav>
		<div class="text-xs tracking-[0.2em] text-(--content-meta) mb-1">
			ARTICLE INDEX
		</div>
		<div class="flex items-center justify-between">
			<h1 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
				文章列表
			</h1>
			<span class="text-sm text-(--content-meta)">共 {allPosts.length} 篇文章</span>
		</div>
	</div>

	<PostPage page={page} />

	{lastPage > 1 && <Pagination page={page} />}
</MainGridLayout>
