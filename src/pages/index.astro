---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";

// 主页：极简欢迎卡片（文章列表已移至 /posts/）
---

<MainGridLayout>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-16 relative w-full text-center onload-animation">
            <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">{siteConfig.title}</div>
            <p class="mt-4 text-base text-neutral-500 dark:text-neutral-400">{siteConfig.subtitle}</p>
        </div>
    </div>
</MainGridLayout>
