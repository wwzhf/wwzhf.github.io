---
import { Icon } from "astro-icon/components";
import CmsEditButton from "@/components/misc/CmsEditButton.astro";
import { siteConfig } from "@/config";
import { profileConfig } from "@/config/profileConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 关于页（fqzlr 风格）：Q&A 格式
//   标题：关于我 / About Me
//   Q1：这个站点用到了哪些技术栈？（含 5 分组折叠面板）
//   Q2：站长社交圈有哪些？（社交账号卡）

// 技术栈分组（用户可按需编辑）
const techGroups = [
	{
		title: "核心框架",
		items: [
			{ name: "Astro 7", desc: "站点骨架，内容驱动的静态框架" },
			{ name: "Svelte 5", desc: "编辑器与交互组件的界面层" },
			{ name: "TypeScript", desc: "全站类型安全" },
			{ name: "Tailwind CSS 4", desc: "原子化样式引擎" },
		],
	},
	{
		title: "内容与渲染",
		items: [
			{ name: "MDX", desc: "关于页的组件化内容" },
			{ name: "Expressive Code", desc: "代码块美化" },
			{ name: "KaTeX", desc: "数学公式渲染" },
			{ name: "Mermaid", desc: "流程图与图表" },
		],
	},
	{
		title: "体验与动效",
		items: [
			{ name: "Swup", desc: "页面无缝过渡，丝滑不闪屏" },
			{ name: "Pagefind", desc: "静态全文搜索" },
			{ name: "GSAP", desc: "动效编排" },
			{ name: "Sakura", desc: "樱花飘落特效" },
		],
	},
	{
		title: "部署与数据",
		items: [
			{ name: "GitHub Pages", desc: "站点托管" },
			{ name: "Cloudflare", desc: "DNS 与静态资源分发" },
			{ name: "Umami", desc: "隐私友好的访问统计" },
		],
	},
	{
		title: "工程化",
		items: [
			{ name: "pnpm", desc: "包管理" },
			{ name: "Biome", desc: "Lint 与格式化" },
			{ name: "Sveltia CMS", desc: "网页端内容管理后台" },
			{ name: "GitHub Actions", desc: "CI 流水线" },
		],
	},
];

// 站点时间线（示例数据；可改读 git log 或 spec/about.md）
const siteTimeline = [
	{ date: "2026.08", tag: "起点", text: "建立博客，开始魔改 Firefly 主题" },
	{ date: "2026.08", tag: "功能", text: "上线 Sveltia CMS 网页端后台" },
	{ date: "2026.08", tag: "功能", text: "上线樱花特效、显示设置面板" },
];

// 社交账号
const socials = [
	{ name: "GitHub", url: profileConfig.github || "https://github.com/", user: "wwzhf", desc: "代码与项目" },
	{ name: "Email", url: `mailto:${profileConfig.email || ""}`, user: profileConfig.email || "", desc: "交流都行" },
	{ name: "RSS", url: "/rss.xml", user: "RSS 订阅", desc: "文章更新推送" },
];
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<article class="prose dark:prose-invert max-w-none card-base px-8 py-6">
		<!-- 标题 -->
		<h2 id="about-me">
			关于我 / About Me
			<a href="#about-me" class="anchor" aria-hidden="true">#</a>
		</h2>

		<p>
			你好，欢迎来到 <strong>{siteConfig.title}</strong>。这里记录我的生活、技术折腾与随手想法。
		</p>
		<p>
			我是 {profileConfig.name || "博主"}，一个喜欢写代码、玩工具、记录生活的普通人～
		</p>
		<p>
			本站采用无登录、纯本地存储设计，数据完全保存在你自己的设备上；通过 JSON 导入/导出实现换机迁移。
		</p>

		<!-- Q1 技术栈 -->
		<h3 id="q1">
			Q1：这个站点用到了哪些技术栈？
			<a href="#q1" class="anchor" aria-hidden="true">#</a>
		</h3>
		<p>
			骨架是 <code>Astro</code>，交互是 <code>Svelte 5</code>，样式交给 <code>Tailwind CSS 4</code>，
			换页用 <code>Swup</code> 丝滑过渡，搜索有 <code>Pagefind</code>，
			写作有自建 <code>/write/</code> 在线编辑器……全是站长亲手挑的料～
		</p>

		<details
			class="tech-stack"
			open
		>
			<summary
				class="cursor-pointer flex items-center gap-2 select-none py-1 font-semibold"
			>
				<Icon name="material-symbols:code-blocks-rounded" class="text-(--primary)" />
				站点技术栈（共 {techGroups.reduce((s, g) => s + g.items.length, 0)} 项）
			</summary>
			<div class="mt-3 space-y-2 pl-1">
				{
					techGroups.map((group) => (
						<details class="group tech-group">
							<summary class="cursor-pointer flex items-center gap-2 text-sm font-medium text-(--primary) py-1">
								<Icon
									name="material-symbols:folder-rounded"
									class="text-base"
								/>
								{group.title}
								<span class="text-(--content-meta)">{group.items.length} 项</span>
							</summary>
							<div class="mt-1 ml-6 space-y-1">
								{group.items.map((item) => (
									<div class="flex items-baseline gap-2 text-sm">
										<a href="#" class="text-(--primary) font-medium shrink-0">
											{item.name}
										</a>
										<span class="text-(--content-meta)">：{item.desc}</span>
									</div>
								))}
							</div>
						</details>
					))
				}
			</div>
		</details>

		<h3>站点更新时间线</h3>
		<ul class="site-timeline space-y-2 list-none pl-0">
			{
				siteTimeline.map((item) => (
					<li class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3 px-3 py-2 rounded-md bg-(--btn-regular-bg)">
						<span class="text-xs font-bold text-(--primary) w-20 shrink-0">{item.date}</span>
						<span class="grow text-sm">{item.text}</span>
						{item.tag && (
							<span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-(--primary)/10 text-(--primary) shrink-0">
								{item.tag}
							</span>
						)}
					</li>
				))
			}
		</ul>

		<!-- Q2 社交圈 -->
		<h3 id="q2">
			Q2：站长社交圈有哪些？
			<a href="#q2" class="anchor" aria-hidden="true">#</a>
		</h3>
		<p>
			如果你也是个喜欢折腾技术的人，或者纯粹只是想找人聊聊，可以通过下面的方式找到我～
		</p>

		<div class="social-grid grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
			{
				socials.map((s) => (
					<a
						href={s.url}
						target={s.url.startsWith("http") || s.url.startsWith("mailto:") ? "_blank" : undefined}
						rel="noopener noreferrer"
						class="flex items-center gap-3 p-3 rounded-lg border border-(--line-divider) hover:border-(--primary) transition-colors"
					>
						<div class="h-10 w-10 rounded-lg bg-(--primary)/10 flex items-center justify-center shrink-0">
							<Icon
								name={
									s.name === "GitHub"
										? "fa7-brands:github"
										: s.name === "Email"
											? "material-symbols:mail-rounded"
											: "material-symbols:rss-feed-rounded"
								}
								class="text-(--primary) text-xl"
							/>
						</div>
						<div class="grow min-w-0">
							<div class="font-medium text-neutral-900 dark:text-neutral-100 truncate">
								{s.name}：{s.user}
							</div>
							<div class="text-xs text-(--content-meta)">{s.desc}</div>
						</div>
					</a>
				))
			}
		</div>
	</article>

	<CmsEditButton collection="pages" entry="about" />
</MainGridLayout>
